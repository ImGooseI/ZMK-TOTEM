#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define NUM  3
#define HYPR 4

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;     // Q + W
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <10 11>;   // A + S
            bindings = <&kp TAB>;
        };

        combo_bksp {
            timeout-ms = <50>;
            key-positions = <8 9>;     // O + P
            bindings = <&kp BACKSPACE>;
        };

        combo_del {
            timeout-ms = <50>;
            key-positions = <18 19>;   // . + /
            bindings = <&kp DELETE>;
        };

        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <13 16>;   // F + J
            bindings = <&caps_word>;
        };

        combo_num {
            timeout-ms = <50>;
            key-positions = <37 38>;   // right mid + right outer
            bindings = <&mo 3>;
        };

        combo_screenshot {
            timeout-ms = <50>;
            key-positions = <35 36>;   // Space + Enter (cross-thumb)
            bindings = <&kp PSCRN>;
        };
    };

    behaviors {
        caps_word: caps_word {
            compatible = "zmk,behavior-caps-word";
            label = "CAPS_WORD";
            #binding-cells = <0>;
            continue-list = <UNDERSCORE MINUS BACKSPACE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
        &kp Q           &kp W        &kp E           &kp R             &kp T          &kp Y      &kp U             &kp I            &kp O        &kp P
        &mt LEFT_GUI A  &mt LCTRL S  &mt LEFT_ALT D  &mt LEFT_SHIFT F  &kp G          &kp H      &mt LEFT_SHIFT J  &mt RIGHT_ALT K  &mt RCTRL L  &mt LEFT_GUI SEMI
&trans  &kp Z           &kp X        &kp C           &kp V             &kp B          &kp N      &kp M             &kp COMMA        &kp DOT      &kp FSLH           &trans
                                     &trans          &mo 2             &lt 1 SPACE    &lt 0 RET  &mo 3             &trans
            >;
        };

        nav_layer {
            label = "NAV";
            bindings = <
        &trans        &trans        &trans     &trans          &trans    &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &trans
        &kp LEFT_GUI  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_SHIFT  &trans    &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans
&trans  &trans        &trans        &trans     &trans          &trans    &trans    &trans     &trans     &trans     &trans  &trans
                                    &trans     &trans          &trans    &trans    &trans     &trans
            >;
        };

        sym_layer {
            label = "SYM";
            bindings = <
        &kp EXCL   &kp AT     &kp HASH   &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR
        &kp GRAVE  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT     &kp LT     &kp GT    &kp LBRC  &kp RBRC  &kp BSLH
&trans  &kp TILDE  &kp UNDER  &kp PLUS   &kp PIPE  &kp SQT      &kp DQT    &trans    &trans    &trans    &trans    &trans
                              &trans     &trans    &trans       &trans     &trans    &trans
            >;
        };

        num_layer {
            label = "NUM";
            bindings = <
        &kp F1   &kp F2   &kp F3  &kp F4  &kp F5     &kp N1  &kp N2  &kp N3  &kp PLUS   &kp STAR
        &kp F6   &kp F7   &kp F8  &kp F9  &kp F10    &kp N4  &kp N5  &kp N6  &kp MINUS  &kp SLASH
&trans  &kp F11  &kp F12  &trans  &trans  &trans     &kp N7  &kp N8  &kp N9  &kp N0     &kp DOT    &trans
                          &trans  &trans  &trans     &trans  &trans  &trans
            >;
        };
    };
};
